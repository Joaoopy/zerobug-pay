# ============================================================
# VARIÁVEIS DE AMBIENTE — ZEROBUG PAY
# ============================================================
# Copie para ".env" e preencha com valores reais.
# NUNCA suba o .env para o GitHub.

# --- Discord ---
DISCORD_TOKEN=seu_token_do_bot_aqui
CLIENT_ID=id_da_aplicacao_do_bot
GUILD_ID=id_do_servidor_zerobug_studio

# --- Cargos de staff (separados por vírgula, sem espaço) ---
CARGOS_STAFF=id_cargo_vendas,id_cargo_admin,id_cargo_fundador

# --- Canais ---
CANAL_LOG_FINANCEIRO=id_do_canal_log_financeiro
CANAL_COMPROVANTES=id_do_canal_comprovantes

# --- Mercado Pago ---
# Comece com credenciais de TESTE, depois troque para produção.
MP_ACCESS_TOKEN=seu_access_token_mercado_pago
MP_PUBLIC_KEY=sua_public_key_mercado_pago

# --- Configurações de cobrança ---
EXPIRACAO_MINUTOS=30

# --- Webhook ---
# Porta que o servidor Express vai escutar (a hospedagem deve
# expor essa porta publicamente para o Mercado Pago conseguir notificar).
WEBHOOK_PORT=3000
